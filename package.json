{
  "name": "context-routing",
  "version": "0.0.1",
  "description": "Context Routing — 4-dimension trigger engine that injects relevant skill files into OpenCode's system prompt, per turn",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "context-routing": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "opencode",
    "plugin",
    "skills",
    "context",
    "router",
    "injection"
  ],
  "license": "MIT",
  "devDependencies": {
    "@opencode-ai/plugin": "^1.3.3",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "js-yaml": "^5.2.1"
  }
}
