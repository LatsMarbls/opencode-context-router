{
  // ── Skill file locations (order = search priority) ────────────────────────
  // {project} = project root directory
  // {user}    = ~/.config/opencode
  // {name}    = skill name (replaced dynamically)
  // First file found wins.
  "skillLocations": [
    "{project}/.opencode/skills/{name}/SKILL.md",
    "{project}/.opencode/agent/{name}.md",
    "{user}/skills/{name}/SKILL.md",
    "{user}/skills/*/{name}/SKILL.md",
    "{user}/agent/{name}.md"
  ],

  // ── Directories to skip when matching path triggers ───────────────────────
  "triggerIgnoreTags": ["node_modules", ".git", "vendor", "dist", ".next", "build"],

  // ── Accumulate skills across turns ────────────────────────────────────────
  // true: skills persist across turns (default). false: fresh each turn.
  "accumulateSkills": true,

  // ── Show TUI toast on skill load/unload ───────────────────────────────────
  "showToasts": true,

  // ── Verbose console logging ──────────────────────────────────────────────
  "debug": false
}
